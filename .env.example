# ===== ENVIRONMENT =====
ENVIRONMENT=development
DEBUG=True

# ===== API KEYS =====
ANTHROPIC_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ===== SERVER =====
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== CACHING (optional) =====
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ===== DATABASE (optional) =====
DATABASE_URL=postgresql://user:password@localhost/fusion_db
